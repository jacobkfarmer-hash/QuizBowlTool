{
  "name": "quiz-bowl-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-runtime.mjs",
    "install:e2e": "node scripts/install-browsers.mjs",
    "test:integration": "vitest run --configLoader runner tests/integration.test.tsx tests/reader.test.ts tests/transfer.test.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dexie": "^4.2.1",
    "dompurify": "^3.3.0",
    "kokoro-js": "^1.2.1",
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.7.0",
    "vitest": "^4.1.11",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "fake-indexeddb": "^6.2.4",
    "@playwright/test": "^1.56.0",
    "esbuild": "npm:esbuild-wasm@0.28.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "esbuild": "$esbuild"
  }
}
